#!/bin/sh
# agenttab: set the terminal title of an agent session to "<state icon> <text>".
#
#   agenttab hook <state> [claude|codex]  run by a hook. Reads the hook JSON on stdin.
#   agenttab set <state> [text]           for an agent with no hooks, such as the OpenCode plugin.
#   agenttab refresh <tty>                write the title again, after a change of name.
#
# The states are idle, busy, wait, and end.
#   agenttab spin <tty> <pid>           the animation of the busy icon. The hook starts it.
#
# The hook must print nothing: Claude and Codex give the stdout of some hooks to the model.
#
# Files in STATE_DIR, for each terminal (for example ttys102):
#   ttys102.name   the name that the user gave in the editor. It comes first.
#   ttys102.text   the text from the agent: the title of the conversation, or the folder.
#   ttys102.state  idle, busy, or wait, while an agent runs.
#   ttys102.spin   the pid of the animation.

CONFIG="${AGENTTAB_CONFIG:-$HOME/.config/agenttab/config}"
STATE_DIR="${AGENTTAB_STATE:-$HOME/.cache/agenttab}"

# Defaults. The config file can change each one.
# An icon with several frames, separated by spaces, is an animation.
ICON_IDLE=""
ICON_BUSY="◐ ◑"
ICON_WAIT="⚠"
SPIN_INTERVAL="0.8"   # seconds between two frames
TEXT="topic"          # topic: the title of the conversation. folder: the name of the directory.
[ -f "$CONFIG" ] && . "$CONFIG"
TTY="" AGENT_PID=""

# The agent process and its terminal: the first ancestor that has a tty.
# Sets AGENT_PID and TTY.
find_tty() {
  pid=$PPID
  while [ -n "$pid" ] && [ "$pid" -gt 1 ]; do
    tty=$(ps -o tty= -p "$pid" 2>/dev/null | tr -d ' ')
    case "$tty" in
      ""|"??"|"?") pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ') ;;
      *) AGENT_PID=$pid; TTY="/dev/$tty"; return 0 ;;
    esac
  done
  return 1
}

# The interactive Codex runs its turns in a shared daemon that has no tty, so
# the hook has no tty among its ancestors. Find the `codex` process that has a
# tty and runs in the same directory. With two or more of them, the tab is not
# known, and agenttab writes nothing. Sets AGENT_PID and TTY.
find_tty_by_cwd() {
  [ -n "$1" ] || return 1
  found="" count=0
  for line in $(ps -Ao pid=,tty=,comm= | awk '$3 ~ /(^|\/)codex$/ && $2 !~ /^\?/ {print $1 ":" $2}'); do
    pid=${line%%:*}
    cwd=$(lsof -a -d cwd -p "$pid" -Fn 2>/dev/null | sed -n 's/^n//p')
    [ "$cwd" = "$1" ] || continue
    found=$line count=$((count + 1))
  done
  [ "$count" -eq 1 ] || return 1
  AGENT_PID=${found%%:*}
  TTY="/dev/${found#*:}"
}

# The title of a Claude Code conversation, or nothing. A name that the user gave
# with /rename (custom-title) comes before the title that Claude Code made (ai-title).
topic() {
  [ -f "$1" ] || return 0
  name=$(grep '"type":"custom-title"' "$1" | tail -1 | jq -r '.customTitle // empty' 2>/dev/null)
  [ -n "$name" ] && { echo "$name"; return 0; }
  grep '"type":"ai-title"' "$1" | tail -1 | jq -r '.aiTitle // empty' 2>/dev/null
}

# The title of a Codex thread, or nothing. Codex adds a line to its index for
# each new name, so the last line of the thread is the current name.
codex_topic() {
  index="${CODEX_HOME:-$HOME/.codex}/session_index.jsonl"
  [ -n "$1" ] && [ -f "$index" ] || return 0
  grep -F "\"id\":\"$1\"" "$index" | tail -1 | jq -r '.thread_name // empty' 2>/dev/null
}

# The path of one state file of a terminal: file <tty> <kind>
file() {
  echo "$STATE_DIR/$(basename "$1").$2"
}

# The text of the title: the name from the editor, else the text from the agent.
label() {
  name=$(cat "$(file "$1" name)" 2>/dev/null)
  [ -n "$name" ] && { echo "$name"; return 0; }
  cat "$(file "$1" text)" 2>/dev/null
}

title() {
  printf '\033]0;%s\007' "${2:+$2 }$3" > "$1"
}

icon_of() {
  case "$1" in
    idle) echo "$ICON_IDLE" ;;
    busy) echo "$ICON_BUSY" ;;
    wait) echo "$ICON_WAIT" ;;
  esac
}

spin_alive() {
  pidfile=$(file "$1" spin)
  [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null
}

# Stop the animation of this terminal, if one runs.
stop_spin() {
  pidfile=$(file "$1" spin)
  [ -f "$pidfile" ] || return 0
  kill "$(cat "$pidfile")" 2>/dev/null
  rm -f "$pidfile"
}

# Read the hook JSON of Claude Code or Codex, and find the text of the title.
hook() {
  state=$1 vendor=${2:-claude}
  input=$(cat)
  cwd=$(printf '%s' "$input" | jq -r '.cwd // empty' 2>/dev/null)
  text=""
  if [ "$TEXT" = "topic" ] && [ "$state" != end ]; then
    case "$vendor" in
      claude) text=$(topic "$(printf '%s' "$input" | jq -r '.transcript_path // empty' 2>/dev/null)") ;;
      codex) text=$(codex_topic "$(printf '%s' "$input" | jq -r '.session_id // empty' 2>/dev/null)") ;;
    esac
  fi
  [ -z "$text" ] && text=$(basename "${cwd:-$PWD}")
  if ! find_tty; then
    [ "$vendor" = codex ] && find_tty_by_cwd "$cwd" || return 0
  fi
  apply "$state" "$text"
}

# Write the state and the title of the terminal of the agent: apply <state> <text>
# The hook finds the terminal before. For `agenttab set`, apply finds it.
apply() {
  state=$1 text=$2
  case "$state" in idle|busy|wait|end) ;; *) return 1 ;; esac
  [ -n "$TTY" ] || find_tty || return 0
  [ -w "$TTY" ] || return 0
  mkdir -p "$STATE_DIR"

  # The session ends: the shell writes its own title again.
  if [ "$state" = end ]; then
    stop_spin "$TTY"
    rm -f "$(file "$TTY" state)" "$(file "$TTY" text)"
    return 0
  fi

  [ -z "$text" ] && text=$(basename "$PWD")
  printf '%s' "$text" > "$(file "$TTY" text)"
  printf '%s' "$state" > "$(file "$TTY" state)"

  # One frame: a static icon. Several frames: an animation.
  icon=$(icon_of "$state")
  set -- $icon
  if [ $# -le 1 ]; then
    stop_spin "$TTY"
    title "$TTY" "$icon" "$(label "$TTY")"
    return 0
  fi

  # Busy again while the animation runs (PostToolUse): let it run.
  spin_alive "$TTY" && return 0
  nohup "$0" spin "$TTY" "$AGENT_PID" </dev/null >/dev/null 2>&1 &
}

# Write the title of a terminal again. The editor calls this after a new name.
# A running animation takes the new name at its next frame.
refresh() {
  tty=$1
  [ -w "$tty" ] || return 1
  spin_alive "$tty" && return 0
  text=$(label "$tty")
  [ -n "$text" ] || return 0
  set -- $(icon_of "$(cat "$(file "$tty" state)" 2>/dev/null)")
  title "$tty" "$1" "$text"
}

# Show each frame in turn. Stop when the agent or the terminal is gone,
# so that no process stays after the session.
#
# Two busy hooks at the same time (tools that end together) can start two
# loops. Each loop writes its pid to the pid file, and the last one wins. A
# loop that does not own the pid file, or that sees a state other than busy,
# stops before its next frame. Two loops out of step make the title blink.
spin() {
  tty=$1 agent=$2
  pidfile=$(file "$tty" spin) statefile=$(file "$tty" state)
  echo $$ > "$pidfile"
  set -- $ICON_BUSY
  while :; do
    for frame in "$@"; do
      kill -0 "$agent" 2>/dev/null || exit 0
      [ "$(cat "$pidfile" 2>/dev/null)" = "$$" ] || exit 0
      [ "$(cat "$statefile" 2>/dev/null)" = busy ] || exit 0
      title "$tty" "$frame" "$(label "$tty")" 2>/dev/null || exit 0
      sleep "$SPIN_INTERVAL"
    done
  done
}

case "$1" in
  hook) shift; hook "$@" >/dev/null 2>&1 ;;
  set) shift; apply "$@" >/dev/null 2>&1 ;;
  refresh) shift; refresh "$@" ;;
  spin) shift; spin "$@" ;;
  *) echo "usage: agenttab hook <state> [claude|codex] | set <state> [text] | refresh <tty>" >&2; exit 2 ;;
esac
exit 0
