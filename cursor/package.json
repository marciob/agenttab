{
  "name": "agenttab",
  "displayName": "agenttab",
  "description": "Give a terminal your own name, and keep the state icon of the agent in it.",
  "version": "0.1.0",
  "publisher": "local",
  "license": "MIT",
  "engines": { "vscode": "^1.80.0" },
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      { "command": "agenttab.rename", "title": "Rename (agenttab)", "category": "Terminal" }
    ],
    "menus": {
      "terminal/title/context": [
        { "command": "agenttab.rename", "group": "agenttab" }
      ]
    }
  }
}
